# Copy to .env and fill in. The Anthropic key is the only required value.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=4000
# Default model used by stations that don't pin their own.
DEFAULT_MODEL=claude-opus-4-8
# Where PGlite persists its data (real PostgreSQL semantics, embedded in-process).
PGLITE_DIR=./data/pgdata

# --- Access control (the API has no login; it trusts only these browser origins/hosts) ---
# Loopback (localhost, 127.0.0.1) is always allowed, including the Vite dev UI on :5173.
# Opening the UI by any OTHER name (LAN IP, Tailscale/tailnet hostname, reverse proxy)
# needs that UI origin listed here, comma-separated. Without it /api answers 403 while
# /ws still connects, so the page loads but nothing saves. The server logs "[origin] refused ...".
#   e.g. ALLOWED_ORIGINS=https://box.tailnet.ts.net:5173,http://192.168.1.20:5173
ALLOWED_ORIGINS=
# Extra bare host names to answer to (anti DNS-rebinding). Hostnames of ALLOWED_ORIGINS are included already.
ALLOWED_HOSTS=
# Non-loopback Vite dev ports treated as the UI (default 5173).
# DEV_UI_PORTS=5173

# --- Optional providers ---
# Key for openai-compatible custom models (OpenRouter, Groq, Ollama, ...). NOT read from
# OPENAI_API_KEY any more: that key is sent only to api.openai.com, never to a custom base_url.
OPENAI_COMPATIBLE_API_KEY=
# OPENAI_API_KEY=   # for provider "openai" (official endpoint only)
# GOOGLE_API_KEY=   # for provider "google"
